# Chave de servidor — usada pela Places API. Restrinja por IP no Google Console.
GOOGLE_PLACES_KEY=

# Chave de browser — usada pelo mapa. Restrinja por HTTP referrer (localhost).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Opcional: ID de mapa do Google Cloud; vazio usa DEMO_MAP_ID para desenvolvimento local.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Caminho do arquivo SQLite
DATABASE_URL=./helix.db
